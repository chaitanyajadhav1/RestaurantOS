generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN_STAFF
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  address   String?
  phone     String?
  settings  Json?    // Queue settings, Tax, Order settings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  customers      Customer[]
  tables         Table[]
  queueEntries   QueueEntry[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  payments       Payment[]
  invitations    Invitation[]
}

model User {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  email        String     @unique
  password     String
  role         Role
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
}

model Customer {
  id           String       @id @default(cuid())
  restaurantId String
  name         String?
  phone        String
  password     String?
  createdAt    DateTime     @default(now())

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  queueEntries QueueEntry[]
  orders       Order[]

  @@unique([restaurantId, phone])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE
}

model Table {
  id           String      @id @default(cuid())
  restaurantId String
  number       String
  capacity     Int
  location     String?
  status       TableStatus @default(AVAILABLE)

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  orders       Order[]
}

enum QueueStatus {
  WAITING
  CALLED
  SEATED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum QueuePriority {
  NORMAL
  PRIORITY
}

model QueueEntry {
  id           String        @id @default(cuid())
  restaurantId String
  customerId   String
  tokenNumber  String
  guests       Int
  preference   String?
  status       QueueStatus   @default(WAITING)
  priority     QueuePriority @default(NORMAL)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  orders       Order[]
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  orderIndex   Int        @default(0)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  items        MenuItem[]
}

model MenuItem {
  id              String       @id @default(cuid())
  restaurantId    String
  categoryId      String
  name            String
  description     String?
  price           Float
  type            String       // Veg, Non-Veg
  isAvailable     Boolean      @default(true)
  preparationTime Int?         // in minutes
  image           String?

  restaurant      Restaurant   @relation(fields: [restaurantId], references: [id])
  category        MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  restaurantId  String
  tableId       String?
  customerId    String?
  queueId       String?
  status        OrderStatus @default(PLACED)
  type          String      // DINE_IN, TAKEAWAY
  subtotal      Float
  tax           Float
  discount      Float       @default(0)
  total         Float
  paymentStatus String      @default("PENDING") // PENDING, PAID, PARTIALLY_PAID
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id])
  table         Table?      @relation(fields: [tableId], references: [id])
  customer      Customer?   @relation(fields: [customerId], references: [id])
  queueEntry    QueueEntry? @relation(fields: [queueId], references: [id])
  items         OrderItem[]
  payments      Payment[]
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  menuItemId          String
  quantity            Int
  price               Float
  specialInstructions String?

  order               Order    @relation(fields: [orderId], references: [id])
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id])
}

model Payment {
  id           String   @id @default(cuid())
  restaurantId String
  orderId      String
  amount       Float
  method       String   // CASH, UPI, CARD
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now())

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  order        Order      @relation(fields: [orderId], references: [id])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model Invitation {
  id           String           @id @default(cuid())
  restaurantId String
  email        String
  role         Role
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())

  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id])
}
